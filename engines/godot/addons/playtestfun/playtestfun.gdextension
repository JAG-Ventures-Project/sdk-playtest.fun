[configuration]

entry_symbol = "playtestfun_library_init"
compatibility_minimum = "4.1"

[libraries]

windows.debug.x86_64 = "res://addons/playtestfun/bin/libplaytestfun.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/playtestfun/bin/libplaytestfun.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://addons/playtestfun/bin/libplaytestfun.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/playtestfun/bin/libplaytestfun.linux.template_release.x86_64.so"
macos.debug = "res://addons/playtestfun/bin/libplaytestfun.macos.template_debug.dylib"
macos.release = "res://addons/playtestfun/bin/libplaytestfun.macos.template_release.dylib"
